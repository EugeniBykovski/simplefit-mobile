{
  "name": "simplefit-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "SimpleFit Boxing mobile app (Expo, iOS and Android).",
  "license": "UNLICENSED",
  "main": "expo-router/entry",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "expo customize tsconfig.json && tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:sync": "node scripts/api-sync.mjs",
    "api:generate": "node scripts/api-sync.mjs --if-present && orval --config orval.config.ts",
    "api:check": "node scripts/api-check.mjs",
    "expo:check": "expo install --check",
    "expo:doctor": "expo-doctor",
    "config:check": "expo config --type public --json > /dev/null",
    "bundle:check": "expo export --platform ios --platform android --output-dir dist --clear",
    "quality": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm api:check && pnpm expo:check && pnpm config:check && pnpm expo:doctor && pnpm bundle:check",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "5.104.1",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.89.0",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-worklets": "0.10.1",
    "use-intl": "4.14.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@react-native/metro-config": "0.86.3",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "57.0.13",
    "eslint": "9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "10.1.8",
    "expo-doctor": "1.20.4",
    "husky": "9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "lint-staged": "17.6.0",
    "orval": "8.39.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "3.4.19",
    "test-renderer": "1.2.0",
    "typescript": "6.0.3"
  }
}
